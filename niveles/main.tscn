[sub_resource type="CSharpScript" id="CSharpScript_ib2p1"]
script/source = "using Godot;

public partial class zonaMuerte : Area2D
{
	public override void _Ready()
	{
		BodyEntered += OnBodyEntered;
	}

	private void OnBodyEntered(Node2D body)
	{
		if (body is Personaje p)
		{
			// Llama al método Reaparecer de forma diferida directamente
			p.CallDeferred(Personaje.MethodName.Reaparecer);
		}
	}
}
"

